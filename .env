PORT=5000
NODE_ENV=development
REDIS_ENABLED=false
MONGODB_ENABLED=true
# TLS end-to-end in dev (cert: dev-cert.pem covers localhost/127.0.0.1/::1/192.168.1.58).
# The CRA dev UI serves the same cert (client/.env SSL_CRT_FILE), so trusting it once
# covers both origins. Run mkcert -install (or import the signing rootCA) to avoid warnings.
HTTPS_ENABLED=true
CLIENT_URL=https://192.168.1.58:3000

# Multi-tenant dev/test domain (Pattern A)
ROOT_DOMAIN=foleys.me.uk
DEFAULT_TENANT_SLUG=demo
DEFAULT_TENANT_ID=tenant-demo
DEFAULT_SUB_TENANT_ID=subtenant-demo
DEFAULT_SITE_ID=site-demo
# Dev-only: bypass auth on WebRTC stats endpoints (ignored when NODE_ENV=production)
ALLOW_WEBRTC_STATS_NO_AUTH=true