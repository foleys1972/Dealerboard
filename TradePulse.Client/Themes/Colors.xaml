<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Canonical dark palette shared by TradePulse.Client.WPF and
        TradePulse.Dealerboard.Client. This is the single source of truth —
        both apps merge this file (see App.xaml) instead of redefining these
        brushes locally. Linked into both projects from this shared file
        (see ..\TradePulse.Client.WPF\TradePulse.Client.WPF.csproj and
        ..\TradePulse.Dealerboard.Client\TradePulse.Dealerboard.Client.csproj)
        so there is exactly one copy on disk.
    -->

    <SolidColorBrush x:Key="TeamsDarkBackground" Color="#1b1b1b"/>
    <SolidColorBrush x:Key="TeamsDarkHeader" Color="#252423"/>
    <SolidColorBrush x:Key="TeamsDarkSurface" Color="#2d2c2c"/>
    <SolidColorBrush x:Key="TeamsDarkSurfaceHover" Color="#323130"/>
    <SolidColorBrush x:Key="TeamsDarkText" Color="#ffffff"/>
    <SolidColorBrush x:Key="TeamsDarkTextSecondary" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="TeamsDarkTextTertiary" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="TeamsDarkBorder" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="TeamsDarkBorderHover" Color="#26FFFFFF"/>

    <SolidColorBrush x:Key="TeamsBlueTransparent" Color="#1A0078D4"/>
    <SolidColorBrush x:Key="TeamsBlueTransparentLight" Color="#330078D4"/>
    <SolidColorBrush x:Key="TeamsBlueBorder" Color="#4D0078D4"/>
    <SolidColorBrush x:Key="TeamsBlue" Color="#0078d4"/>
    <SolidColorBrush x:Key="TeamsBlueHover" Color="#106ebe"/>

    <SolidColorBrush x:Key="TeamsRed" Color="#d13438"/>
    <SolidColorBrush x:Key="TeamsRedHover" Color="#a4262c"/>
    <SolidColorBrush x:Key="TeamsGreen" Color="#107c10"/>
    <SolidColorBrush x:Key="TeamsYellow" Color="#ffaa44"/>

    <!--
        Dark-theme-appropriate error/danger surface. Previously each window
        that needed an error banner improvised its own colors; one window
        (Dealerboard LoginWindow) used a light-mode banner (#FFEBEE on
        #F44336) that looked out of place against the dark background.
    -->
    <SolidColorBrush x:Key="TeamsErrorSurface" Color="#3D1F1F"/>
    <SolidColorBrush x:Key="TeamsErrorBorder" Color="#d13438"/>
    <SolidColorBrush x:Key="TeamsErrorText" Color="#ff6b6b"/>

</ResourceDictionary>
