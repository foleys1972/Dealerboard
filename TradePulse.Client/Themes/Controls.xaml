<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared control styles for TradePulse.Client.WPF and
        TradePulse.Dealerboard.Client, built on the palette in Colors.xaml.
        Single source of truth — see Colors.xaml for the sharing mechanism.
        App-specific styles (e.g. broadcast PTT/latch buttons) stay local to
        the window that uses them; only general-purpose chrome lives here.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ToggleButton (dark switch) -->
    <Style x:Key="TeamsToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Background" Value="#3a3a3a"/>
        <Setter Property="BorderBrush" Value="#3a3a3a"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Border x:Name="Track"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Ellipse x:Name="Thumb"
                                 Width="16"
                                 Height="16"
                                 Fill="White"
                                 Margin="2,2,2,2"
                                 HorizontalAlignment="Left"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource TeamsBlue}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TeamsBlue}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card-style section container -->
    <Style x:Key="SectionStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TeamsDarkSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TeamsDarkBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="600"/>
        <Setter Property="Foreground" Value="{StaticResource TeamsDarkText}"/>
    </Style>

    <!-- Flat button family -->
    <Style x:Key="TeamsButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TeamsDarkBorder}"/>
        <Setter Property="Foreground" Value="{StaticResource TeamsDarkText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TeamsDarkBorderHover}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="400"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TeamsDarkBorderHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TeamsDarkBorderHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#26FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TeamsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TeamsButtonStyle}">
        <Setter Property="Background" Value="{StaticResource TeamsBlue}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TeamsBlueHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TeamsGreenButtonStyle" TargetType="Button" BasedOn="{StaticResource TeamsButtonStyle}">
        <Setter Property="Background" Value="{StaticResource TeamsGreen}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style x:Key="TeamsDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource TeamsButtonStyle}">
        <Setter Property="Background" Value="{StaticResource TeamsRed}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TeamsRedHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Dark-theme error banner (Border + inner TextBlock use these keys) -->
    <Style x:Key="TeamsErrorBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TeamsErrorSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TeamsErrorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style x:Key="TeamsErrorTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TeamsErrorText}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

</ResourceDictionary>
