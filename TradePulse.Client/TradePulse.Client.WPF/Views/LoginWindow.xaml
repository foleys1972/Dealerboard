<Window x:Class="TradePulse.Client.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="TradeCom - Login" 
        Height="700" 
        Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1b1b1b"
        FontFamily="Segoe UI">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Logo -->
        <StackPanel Grid.Row="0" Margin="0,0,0,40">
            <materialDesign:PackIcon Kind="AccountCircle" 
                                     Width="80" 
                                     Height="80" 
                                     HorizontalAlignment="Center"
                                     Foreground="#0078d4"
                                     Margin="0,0,0,15"/>
            <TextBlock Text="TradeCom" 
                       FontSize="42" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="White"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Trading Communication Platform" 
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Foreground="#B3FFFFFF"
                       Opacity="0.9"/>
        </StackPanel>

        <!-- Login Form -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Server URL (with auto-detect) -->
            <TextBlock Text="Server Address" 
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"
                       Foreground="#B3FFFFFF"/>
            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         x:Name="ServerUrlTextBox"
                         materialDesign:HintAssist.Hint="https://192.168.1.58:5000"
                         materialDesign:HintAssist.IsFloating="True"
                         FontSize="16"
                         Height="50"
                         Padding="12,0"
                         Background="#2d2c2c"
                         Foreground="#ffffff"
                         BorderBrush="#26FFFFFF"
                         Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="Test"
                            Command="{Binding TestConnectionCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Padding="12,8"
                            FontSize="13"
                            ToolTip="Test connection to server"
                            Margin="0,0,5,0"/>
                    <Button Content="Auto"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,0,0"
                            Padding="12,8"
                            FontSize="13"
                            ToolTip="Auto-detect server IP"
                            Click="AutoDetectButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Username -->
            <TextBox x:Name="UsernameTextBox"
                     materialDesign:HintAssist.Hint="Username"
                     materialDesign:HintAssist.IsFloating="True"
                     Margin="0,0,0,20"
                     FontSize="18"
                     Height="55"
                     Padding="12,0"
                     Background="#2d2c2c"
                     Foreground="#ffffff"
                     BorderBrush="#26FFFFFF"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Password -->
            <PasswordBox x:Name="PasswordBox"
                        materialDesign:HintAssist.Hint="Password"
                        materialDesign:HintAssist.IsFloating="True"
                        Margin="0,0,0,25"
                        FontSize="18"
                        Height="55"
                        Padding="12,0"
                        Background="#2d2c2c"
                        Foreground="#ffffff"
                        BorderBrush="#26FFFFFF"
                        PasswordChanged="PasswordBox_PasswordChanged"/>

            <!-- Error Message -->
            <Border Background="#FFEBEE"
                    BorderBrush="#F44336"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,15"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircle" 
                                           Foreground="#F44336"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#C62828"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="15"
                       Foreground="#0078d4"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"
                       FontWeight="SemiBold"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Text" Value="Connecting to server..."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Login Button -->
            <Button Content="LOGIN"
                    Command="{Binding LoginCommand}"
                    IsDefault="True"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Padding="40,16"
                    FontSize="18"
                    FontWeight="Bold"
                    Margin="0,0,0,20"
                    Height="55"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>

            <!-- Connection Info -->
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0">
                <Ellipse Width="10" 
                         Height="10" 
                         Margin="0,0,8,0"
                         VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{Binding IsLoading, Converter={StaticResource BooleanToColorConverter}}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="Ready to connect"
                           FontSize="14"
                           Foreground="#80FFFFFF"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
