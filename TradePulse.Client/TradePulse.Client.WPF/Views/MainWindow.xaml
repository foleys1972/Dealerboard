<Window x:Class="TradePulse.Client.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:TradePulse.Client.Core.Models;assembly=TradePulse.Client.Core"
        xmlns:converters="clr-namespace:TradePulse.Client.WPF.Converters;assembly=TradePulse.Client.WPF"
        xmlns:local="clr-namespace:TradePulse.Client.WPF;assembly=TradePulse.Client.WPF"
        xmlns:parts="clr-namespace:TradePulse.Client.WPF.Views.MainWindowParts"
        mc:Ignorable="d"
        Title="TradeCom - Trading Communication Platform" 
        Height="900" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1b1b1b"
        FontFamily="Segoe UI">
    <!-- Colors and general control styles (SectionStyle, TeamsButtonStyle,
         TeamsToggleSwitchStyle, etc.) come from the shared Themes/Colors.xaml
         and Themes/Controls.xaml merged in App.xaml. Broadcast PTT/Latch
         styles moved into MainWindowParts/BroadcastMonitorsPanel.xaml along
         with the markup that uses them. -->

    <Grid Background="{StaticResource TeamsDarkBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <parts:HeaderBar Grid.Row="0"/>

        <!-- Incoming Call Banner -->
        <Border Visibility="Collapsed"/>

        <!-- In-Call Banner (prominent red) -->
        <Border Grid.Row="0"
                Background="{StaticResource TeamsRed}"
                CornerRadius="6"
                Padding="12"
                Margin="24,64,24,0"
                VerticalAlignment="Top"
                Visibility="Collapsed">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource TeamsRed}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentCall.State}" Value="Connected">
                            <Setter Property="Background" Value="{StaticResource TeamsGreen}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0"
                                         Kind="PhoneInTalk"
                                         Width="20"
                                         Height="20"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CALL IN PROGRESS"
                               FontSize="12"
                               FontWeight="700"
                               Foreground="White"/>
                    <TextBlock Text="{Binding CallStatus}"
                               FontSize="13"
                               FontWeight="600"
                               Foreground="White"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#26FFFFFF"
                            CornerRadius="10"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding CallDuration}"
                                   FontSize="12"
                                   FontWeight="700"
                                   Foreground="White"/>
                    </Border>
                    <Button Style="{StaticResource TeamsDangerButtonStyle}"
                            Command="{Binding HangupCommand}"
                            Padding="10,6"
                            ToolTip="Hang up">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PhoneHangup" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="End" Foreground="White" FontSize="13" FontWeight="600"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" 
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Padding="24">
            <Grid>
            <Grid.ColumnDefinitions>
                    <!-- Proportional instead of a fixed 440px so the contacts
                         panel scales with window/monitor size, clamped to a
                         usable range rather than staying pinned. -->
                    <ColumnDefinition Width="0.32*" MinWidth="360" MaxWidth="520"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

                <!-- Left Panel: Contacts & Groups -->
                <parts:ContactsPanel x:Name="ContactsPanelControl" Grid.Column="0"/>

                <!-- Right Panel: Main Content with Grid Layout -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Grid Layout for Broadcasts, Groups, Contacts -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <parts:BroadcastMonitorsPanel Grid.Column="0" Margin="0,0,6,0"/>
                        <parts:GroupCallsPanel Grid.Column="1" Margin="3,0"/>
                        <parts:DirectContactsPanel Grid.Column="2" Margin="6,0,0,0"/>
                    </Grid>

                <!-- Call Status/Info Area -->
                <Border Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Floating Call Bar -->
        <parts:FloatingCallBar Grid.Row="2"/>

    </Grid>
</Window>
