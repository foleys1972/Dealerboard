<Window x:Class="TradePulse.Client.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:TradePulse.Client.Core.Models;assembly=TradePulse.Client.Core"
        xmlns:converters="clr-namespace:TradePulse.Client.WPF.Converters;assembly=TradePulse.Client.WPF"
        xmlns:local="clr-namespace:TradePulse.Client.WPF;assembly=TradePulse.Client.WPF"
        mc:Ignorable="d"
        Title="TradePulse - Trading Communication Platform" 
        Height="900" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#1b1b1b"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Teams Dark Theme Colors -->
        <SolidColorBrush x:Key="TeamsDarkBackground" Color="#1b1b1b"/>
        <SolidColorBrush x:Key="TeamsDarkHeader" Color="#252423"/>
        <SolidColorBrush x:Key="TeamsDarkSurface" Color="#2d2c2c"/>
        <SolidColorBrush x:Key="TeamsDarkSurfaceHover" Color="#323130"/>
        <SolidColorBrush x:Key="TeamsDarkText" Color="#ffffff"/>
        <SolidColorBrush x:Key="TeamsDarkTextSecondary" Color="#B3FFFFFF"/>
        <SolidColorBrush x:Key="TeamsDarkTextTertiary" Color="#80FFFFFF"/>
        <SolidColorBrush x:Key="TeamsDarkBorder" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="TeamsDarkBorderHover" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="TeamsBlueTransparent" Color="#1A0078D4"/>
        <SolidColorBrush x:Key="TeamsBlueBorder" Color="#4D0078D4"/>
        <SolidColorBrush x:Key="TeamsBlue" Color="#0078d4"/>
        <SolidColorBrush x:Key="TeamsBlueHover" Color="#106ebe"/>
        <SolidColorBrush x:Key="TeamsRed" Color="#d13438"/>
        <SolidColorBrush x:Key="TeamsRedHover" Color="#a4262c"/>
        <SolidColorBrush x:Key="TeamsGreen" Color="#107c10"/>
        <SolidColorBrush x:Key="TeamsYellow" Color="#ffaa44"/>
        
        <!-- Section Style -->
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TeamsDarkSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TeamsDarkBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        
        <!-- Section Title Style -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="Foreground" Value="{StaticResource TeamsDarkText}"/>
        </Style>
        
        <!-- Button Style -->
        <Style x:Key="TeamsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TeamsDarkBorder}"/>
            <Setter Property="Foreground" Value="{StaticResource TeamsDarkText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TeamsDarkBorderHover}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="400"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TeamsDarkBorderHover}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource TeamsDarkBorderHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#26FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Primary Button Style -->
        <Style x:Key="TeamsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TeamsButtonStyle}">
            <Setter Property="Background" Value="{StaticResource TeamsBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TeamsBlueHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Danger Button Style -->
        <Style x:Key="TeamsDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource TeamsButtonStyle}">
            <Setter Property="Background" Value="{StaticResource TeamsRed}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TeamsRedHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Background="{StaticResource TeamsDarkBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource TeamsDarkHeader}"
                BorderBrush="{StaticResource TeamsDarkBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Phone" 
                                           Width="20" 
                                           Height="20"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                        <TextBlock Text="TradePulse" 
                               FontSize="18" 
                               FontWeight="600"
                                   Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Connection Status -->
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0">
                    <Ellipse Width="10" 
                             Height="10" 
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Fill="{Binding IsConnected, Converter={StaticResource BooleanToColorConverter}}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectionStatus}"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="400"
                               Margin="0,0,8,0"/>
                        <Button Content="Retry"
                                Style="{StaticResource TeamsButtonStyle}"
                                Command="{Binding RetrySocketConnectionCommand}"
                                Padding="6,4"
                                FontSize="12"
                                Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                ToolTip="Retry Socket.IO connection"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal" 
                           VerticalAlignment="Center">
                    <Button Content="Settings"
                            Style="{StaticResource TeamsButtonStyle}"
                            Command="{Binding SettingsCommand}"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource TeamsButtonStyle}"
                            Command="{Binding LogoutCommand}"
                            ToolTip="Logout">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ExitToApp" 
                                                   Width="16" 
                                                   Height="16"
                                                   Foreground="White"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                            <TextBlock Text="Logout" 
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" 
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Padding="24">
            <Grid>
            <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

                <!-- Left Panel: Contacts & Groups -->
            <Border Grid.Column="0" 
                        BorderBrush="{StaticResource TeamsDarkBorder}"
                    BorderThickness="0,0,1,0"
                        Margin="0,0,24,0"
                        Padding="0,0,24,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Contacts" 
                                       FontSize="20" 
                                       FontWeight="600"
                                       Foreground="{StaticResource TeamsDarkText}"
                                       Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="Search contacts..."
                                 materialDesign:HintAssist.IsFloating="True"
                                     FontSize="14"
                                     Height="40"
                                 Padding="12,0"
                                     Background="{StaticResource TeamsDarkSurface}"
                                     Foreground="{StaticResource TeamsDarkText}"
                                     BorderBrush="{StaticResource TeamsDarkBorderHover}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- User Configuration Panel -->
                    <Border Grid.Row="1" 
                           Visibility="{Binding CurrentUser, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Background="{StaticResource TeamsDarkSurface}"
                               BorderBrush="{StaticResource TeamsDarkBorder}"
                           BorderThickness="1"
                               CornerRadius="4"
                               Padding="12"
                               Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="User Configuration" 
                                          FontWeight="600"
                                          FontSize="14"
                                          Foreground="{StaticResource TeamsDarkText}"
                                          Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Intercom:" FontWeight="400" Margin="0,0,10,4" Foreground="{StaticResource TeamsDarkTextSecondary}" FontSize="12"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" 
                                              FontWeight="600"
                                              Margin="0,0,0,4"
                                              FontSize="12"
                                              Text="{Binding CurrentUser.IntercomEnabled}"
                                              Foreground="{Binding CurrentUser.IntercomEnabled, Converter={StaticResource BooleanToColorConverter}}"/>
                                
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Dealerboard:" FontWeight="400" Margin="0,0,10,4" Foreground="{StaticResource TeamsDarkTextSecondary}" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" 
                                              FontWeight="600"
                                              Margin="0,0,0,4"
                                              FontSize="12"
                                              Text="{Binding CurrentUser.DealerboardEnabled}"
                                              Foreground="{Binding CurrentUser.DealerboardEnabled, Converter={StaticResource BooleanToColorConverter}}"/>
                                
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Role:" FontWeight="400" Margin="0,0,10,0" Foreground="{StaticResource TeamsDarkTextSecondary}" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" 
                                          Text="{Binding CurrentUser.Role}"
                                              Foreground="{StaticResource TeamsDarkTextTertiary}"
                                              FontWeight="400"
                                              FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                        <!-- Groups Section -->
                    <Border Grid.Row="2" 
                           Visibility="{Binding CurrentUser, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Background="{StaticResource TeamsDarkSurface}"
                               BorderBrush="{StaticResource TeamsDarkBorder}"
                           BorderThickness="1"
                               CornerRadius="4"
                               Padding="12"
                               Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Groups" 
                                          FontWeight="600"
                                          FontSize="14"
                                          Foreground="{StaticResource TeamsDarkText}"
                                          Margin="0,0,0,8"/>
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <ListBox ItemsSource="{Binding Groups}"
                                        SelectedItem="{Binding SelectedGroup}"
                                        BorderThickness="0"
                                        Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                                <Border Background="{StaticResource TeamsDarkSurface}"
                                                       Padding="10,8"
                                                       Margin="0,0,0,6"
                                                       CornerRadius="4"
                                                       BorderBrush="{StaticResource TeamsDarkBorder}"
                                                   BorderThickness="1"
                                                   Cursor="Hand">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" 
                                                                  FontWeight="400"
                                                                  FontSize="13"
                                                                  Foreground="{StaticResource TeamsDarkText}"/>
                                                    <TextBlock Text="{Binding Description}" 
                                                                  FontSize="11"
                                                                  Foreground="{StaticResource TeamsDarkTextTertiary}"
                                                              Margin="0,4,0,0"
                                                              TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Panel: Main Content with Grid Layout -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Grid Layout for Broadcasts, Groups, Contacts -->
                    <UniformGrid Columns="3" 
                                Rows="1"
                                Visibility="{Binding IsInCall, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        
                        <!-- Broadcast Monitors Section -->
                        <Border Style="{StaticResource SectionStyle}" Margin="0,0,6,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Radio" Width="16" Height="16" Foreground="{StaticResource TeamsDarkTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="BROADCAST MONITORS" Style="{StaticResource SectionTitleStyle}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{StaticResource TeamsBlueTransparent}"
                                            BorderBrush="{StaticResource TeamsBlueBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActiveBroadcastCount, StringFormat='{}{0} active'}"
                                                  FontSize="11"
                                                  Foreground="{StaticResource TeamsBlue}"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                
                                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Broadcasts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource TeamsDarkBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="10"
                                                        Margin="0,0,0,8"
                                                        Cursor="Hand">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource TeamsDarkSurface}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource TeamsBlueTransparentLight}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource TeamsBlueBorder}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Name}" 
                                                                          FontWeight="400"
                                                                          FontSize="13"
                                                                          Foreground="{StaticResource TeamsDarkText}"
                                                                          Margin="0,0,0,4"/>
                                                                <TextBlock Text="{Binding ListenerCount, StringFormat='{}{0} monitoring'}"
                                                                          FontSize="11"
                                                                          Foreground="{StaticResource TeamsDarkTextTertiary}"/>
                                                            </StackPanel>
                                                            <ToggleButton Grid.Column="1"
                                                                         IsChecked="{Binding IsActive}"
                                                                         Command="{Binding DataContext.ToggleBroadcastMonitorForItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         CommandParameter="{Binding}"
                                                                         Width="32"
                                                                         Height="20"
                                                                         VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <Button Content="PTT"
                                                                Style="{StaticResource TeamsButtonStyle}"
                                      Margin="0,8,0,0"
                                                                Command="{Binding DataContext.StartBroadcastPTTCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                        </StackPanel>
                    </Border>

                        <!-- Group Calls Section -->
                        <Border Style="{StaticResource SectionStyle}" Margin="3,0">
                        <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Users" Width="16" Height="16" Foreground="{StaticResource TeamsDarkTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="GROUP CALLS" Style="{StaticResource SectionTitleStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource TeamsButtonStyle}"
                                            Command="{Binding CreateGroupCommand}"
                                            Padding="6,4">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Foreground="{StaticResource TeamsDarkText}" Margin="0,0,4,0"/>
                                            <TextBlock Text="New" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                
                                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding GroupCalls}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                                <Border Background="{StaticResource TeamsDarkSurface}"
                                                        BorderBrush="{StaticResource TeamsDarkBorder}"
                                                   BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="12"
                                                        Margin="0,0,6,6"
                                                        Cursor="Hand"
                                                        MouseLeftButtonDown="GroupCallItem_MouseLeftButtonDown">
                                                    <TextBlock Text="{Binding Name}" 
                                                              FontWeight="400"
                                                              FontSize="13"
                                                              Foreground="{StaticResource TeamsDarkText}"
                                                              TextAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                        <!-- Direct Contacts Section -->
                        <Border Style="{StaticResource SectionStyle}" Margin="6,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Phone" Width="16" Height="16" Foreground="{StaticResource TeamsDarkTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="DIRECT CONTACTS" Style="{StaticResource SectionTitleStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource TeamsButtonStyle}"
                                            Command="{Binding AddContactCommand}"
                                            Padding="6,4">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Foreground="{StaticResource TeamsDarkText}" Margin="0,0,4,0"/>
                                            <TextBlock Text="Add" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                
                                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding DirectContacts}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                                <Border Background="{StaticResource TeamsDarkSurface}"
                                                        BorderBrush="{StaticResource TeamsDarkBorder}"
                                           BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="10"
                                                        Margin="0,0,6,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                                        <Ellipse Grid.Column="0"
                                                                Width="8"
                                                             Height="8" 
                                                                Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                                        <TextBlock Grid.Column="1"
                                                                  Text="{Binding Name}"
                                                                  FontWeight="400"
                                                                  FontSize="13"
                                                                  Foreground="{StaticResource TeamsDarkText}"
                                                                  VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                                            <Button Style="{StaticResource TeamsPrimaryButtonStyle}"
                                                                    Padding="6,4"
                                                                    Margin="0,0,4,0"
                                                                    Command="{Binding DataContext.StartVoiceCallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}"
                                                                    ToolTip="Voice Call">
                                                                <materialDesign:PackIcon Kind="Phone" Width="14" Height="14" Foreground="White"/>
                                                </Button>
                                                            <Button Style="{StaticResource TeamsPrimaryButtonStyle}"
                                                                    Padding="6,4"
                                                                    Command="{Binding DataContext.StartVideoCallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}"
                                                                    ToolTip="Video Call">
                                                                <materialDesign:PackIcon Kind="Video" Width="14" Height="14" Foreground="White"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                    </ScrollViewer>
                        </StackPanel>
                    </Border>
                    </UniformGrid>

                <!-- Call Status/Info Area -->
                <Border Grid.Row="0"
                           Background="{StaticResource TeamsDarkSurface}"
                           CornerRadius="4"
                       Padding="50"
                           BorderBrush="{StaticResource TeamsDarkBorder}"
                       BorderThickness="1"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsInCall, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="120" 
                                   Height="120" 
                                   Background="{StaticResource TeamsBlue}"
                                   CornerRadius="60"
                                   Margin="0,0,0,30"
                               HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Phone" 
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                       Width="60"
                                                       Height="60"/>
                        </Border>
                        <TextBlock Text="{Binding CallStatus}"
                                       FontSize="28"
                                       FontWeight="600"
                                   HorizontalAlignment="Center"
                                       Foreground="{StaticResource TeamsDarkText}"
                                   Margin="0,0,0,12"/>
                            <TextBlock FontSize="16"
                                   HorizontalAlignment="Center"
                                       Foreground="{StaticResource TeamsDarkTextTertiary}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} - {1}">
                                    <Binding Path="CurrentCall.Type"/>
                                    <Binding Path="CurrentCall.GroupName"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Floating Call Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource TeamsDarkHeader}"
                BorderBrush="{StaticResource TeamsDarkBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,10"
                       Visibility="{Binding IsInCall, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                <!-- Call Status Indicator -->
                <Ellipse Grid.Column="0"
                        Width="10"
                        Height="10"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Fill="{StaticResource TeamsGreen}"/>
                
                <!-- Call Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CallStatus}"
                               FontSize="14"
                               FontWeight="600"
                               Foreground="{StaticResource TeamsDarkText}"
                               Margin="0,0,0,2"/>
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource TeamsDarkTextTertiary}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} • {1}">
                                <Binding Path="CallDuration"/>
                                <Binding Path="CurrentCall.Type"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                            </StackPanel>
                
                <!-- Call Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding MuteCommand}"
                            Style="{StaticResource TeamsButtonStyle}"
                            Margin="0,0,8,0"
                            Padding="10,6"
                            ToolTip="Mute">
                        <materialDesign:PackIcon Kind="MicrophoneOff" Width="18" Height="18" Foreground="{StaticResource TeamsDarkText}"/>
                    </Button>
                    <Button Command="{Binding HangupCommand}"
                            Style="{StaticResource TeamsDangerButtonStyle}"
                            Padding="12,6"
                            ToolTip="End Call">
                            <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PhoneHangup" Width="18" Height="18" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="End Call" Foreground="White" FontSize="13" FontWeight="600"/>
                            </StackPanel>
                        </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
