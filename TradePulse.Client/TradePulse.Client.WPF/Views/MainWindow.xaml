<Window x:Class="TradePulse.Client.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:TradePulse.Client.Core.Models;assembly=TradePulse.Client.Core"
        xmlns:converters="clr-namespace:TradePulse.Client.WPF.Converters;assembly=TradePulse.Client.WPF"
        xmlns:local="clr-namespace:TradePulse.Client.WPF;assembly=TradePulse.Client.WPF"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:parts="clr-namespace:TradePulse.Client.WPF.Views.MainWindowParts"
        mc:Ignorable="d"
        Title="TradeCom - Trading Communication Platform" 
        Height="900" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1b1b1b"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Colors and general control styles (SectionStyle, TeamsButtonStyle,
             TeamsToggleSwitchStyle, etc.) come from the shared Themes/Colors.xaml
             and Themes/Controls.xaml merged in App.xaml. Only styles specific to
             this window stay here. -->

        <!-- Broadcast PTT/Latch styles -->
        <Style x:Key="BroadcastPttButtonStyle" TargetType="Button" BasedOn="{StaticResource TeamsButtonStyle}">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource TeamsDarkBorderHover}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPttTransmitting}" Value="True">
                    <Setter Property="Background" Value="{StaticResource TeamsGreen}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPttLatched}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource TeamsBlueBorder}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BroadcastLatchButtonStyle" TargetType="Button" BasedOn="{StaticResource TeamsButtonStyle}">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource TeamsDarkBorderHover}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPttLatched}" Value="True">
                    <Setter Property="Background" Value="{StaticResource TeamsBlue}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Background="{StaticResource TeamsDarkBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <parts:HeaderBar Grid.Row="0"/>

        <!-- Incoming Call Banner -->
        <Border Visibility="Collapsed"/>

        <!-- In-Call Banner (prominent red) -->
        <Border Grid.Row="0"
                Background="{StaticResource TeamsRed}"
                CornerRadius="6"
                Padding="12"
                Margin="24,64,24,0"
                VerticalAlignment="Top"
                Visibility="Collapsed">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource TeamsRed}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentCall.State}" Value="Connected">
                            <Setter Property="Background" Value="{StaticResource TeamsGreen}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0"
                                         Kind="PhoneInTalk"
                                         Width="20"
                                         Height="20"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CALL IN PROGRESS"
                               FontSize="12"
                               FontWeight="700"
                               Foreground="White"/>
                    <TextBlock Text="{Binding CallStatus}"
                               FontSize="13"
                               FontWeight="600"
                               Foreground="White"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#26FFFFFF"
                            CornerRadius="10"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding CallDuration}"
                                   FontSize="12"
                                   FontWeight="700"
                                   Foreground="White"/>
                    </Border>
                    <Button Style="{StaticResource TeamsDangerButtonStyle}"
                            Command="{Binding HangupCommand}"
                            Padding="10,6"
                            ToolTip="Hang up">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PhoneHangup" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="End" Foreground="White" FontSize="13" FontWeight="600"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" 
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Padding="24">
            <Grid>
            <Grid.ColumnDefinitions>
                    <!-- Proportional instead of a fixed 440px so the contacts
                         panel scales with window/monitor size, clamped to a
                         usable range rather than staying pinned. -->
                    <ColumnDefinition Width="0.32*" MinWidth="360" MaxWidth="520"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

                <!-- Left Panel: Contacts & Groups -->
                <parts:ContactsPanel x:Name="ContactsPanelControl" Grid.Column="0"/>

                <!-- Right Panel: Main Content with Grid Layout -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Grid Layout for Broadcasts, Groups, Contacts -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Broadcast Monitors Section -->
                        <Border Grid.Column="0" Style="{StaticResource SectionStyle}" Margin="0,0,6,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Radio" Width="16" Height="16" Foreground="{StaticResource TeamsDarkTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="BROADCAST MONITORS" Style="{StaticResource SectionTitleStyle}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{StaticResource TeamsBlueTransparent}"
                                            BorderBrush="{StaticResource TeamsBlueBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActiveBroadcastCount, StringFormat='{}{0} active'}"
                                                  FontSize="11"
                                                  Foreground="{StaticResource TeamsBlue}"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                
                                <ItemsControl ItemsSource="{Binding Broadcasts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource TeamsDarkBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    Margin="0,0,0,8"
                                                    Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource TeamsDarkSurface}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource TeamsBlueTransparentLight}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource TeamsBlueBorder}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock FontSize="11"
                                                                      Foreground="{StaticResource TeamsDarkTextTertiary}"
                                                                      Margin="0,0,0,2">
                                                                <Run Text="Line "/>
                                                                <Run Text="{Binding SlotIndex, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <TextBlock Text="{Binding Name}" 
                                                                          FontWeight="400"
                                                                          FontSize="13"
                                                                          Foreground="{StaticResource TeamsDarkText}"
                                                                          VerticalAlignment="Center"/>

                                                                <Border Background="{StaticResource TeamsGreen}"
                                                                        CornerRadius="8"
                                                                        Padding="6,1"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding IsVoxActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="AUDIO"
                                                                              FontSize="10"
                                                                              FontWeight="600"
                                                                              Foreground="White"
                                                                              VerticalAlignment="Center"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ListenerCount, StringFormat='{}{0} monitoring'}"
                                                                      FontSize="11"
                                                                      Foreground="{StaticResource TeamsDarkTextTertiary}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <ToggleButton IsChecked="{Binding IsActive, Mode=OneWay}"
                                                                         Command="{Binding DataContext.ToggleBroadcastMonitorForItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         CommandParameter="{Binding}"
                                                                         Style="{StaticResource TeamsToggleSwitchStyle}"
                                                                         Margin="0,0,0,6"
                                                                         IsEnabled="{Binding IsConfigured}"/>
                                                            <Button Content="Assign"
                                                                    Style="{StaticResource TeamsButtonStyle}"
                                                                    Padding="6,4"
                                                                    FontSize="12"
                                                                    Command="{Binding DataContext.ConfigureBroadcastSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,8,0,0" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Button Grid.Column="0"
                                                                Content="PTT"
                                                                Style="{StaticResource BroadcastPttButtonStyle}"
                                                                PreviewMouseLeftButtonDown="BroadcastPttButton_PreviewMouseLeftButtonDown"
                                                                PreviewMouseLeftButtonUp="BroadcastPttButton_PreviewMouseLeftButtonUp"
                                                                ToolTip="PTT (green when transmitting)"/>

                                                        <Button Grid.Column="1"
                                                                Content="Latch"
                                                                Style="{StaticResource BroadcastLatchButtonStyle}"
                                                                Margin="8,0,0,0"
                                                                Padding="10,6"
                                                                Command="{Binding DataContext.ToggleBroadcastLatchForItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Toggle latch mode"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </StackPanel>
                    </Border>

                        <!-- Group Calls Section -->
                        <Border Grid.Column="1" Style="{StaticResource SectionStyle}" Margin="3,0">
                        <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Users" Width="16" Height="16" Foreground="{StaticResource TeamsDarkTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="GROUP CALLS" Style="{StaticResource SectionTitleStyle}"/>
                                    </StackPanel>
                                </Grid>
                                
                                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding GroupCalls}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                                <Border BorderBrush="{StaticResource TeamsDarkBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="12"
                                                        Margin="0,0,6,6"
                                                        Cursor="Hand"
                                                        MouseLeftButtonDown="GroupCallItem_MouseLeftButtonDown">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource TeamsDarkSurface}"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.55"/>
                                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{StaticResource TeamsDarkTextTertiary}"
                                                                   Margin="0,0,0,2"
                                                                   TextAlignment="Center">
                                                            <Run Text="Button "/>
                                                            <Run Text="{Binding SlotIndex, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="400"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource TeamsDarkText}"
                                                                   TextAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                        </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                            </ScrollViewer>

                                <Border Background="{StaticResource TeamsDarkSurface}"
                                        BorderBrush="{StaticResource TeamsDarkBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="12"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <materialDesign:PackIcon Kind="Bell" Width="16" Height="16" Foreground="{StaticResource TeamsDarkTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="NOTIFICATIONS" Style="{StaticResource SectionTitleStyle}"/>
                                        </StackPanel>

                                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Notifications}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource TeamsDarkSurface}"
                                                                BorderBrush="{StaticResource TeamsDarkBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="10"
                                                                Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <materialDesign:PackIcon Grid.Column="0"
                                                                                        Kind="{Binding IconKind}"
                                                                                        Width="18"
                                                                                        Height="18"
                                                                                        Foreground="{StaticResource TeamsBlue}"
                                                                                        Margin="0,0,10,0"
                                                                                        VerticalAlignment="Top"/>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontWeight="700"
                                                                               FontSize="12"
                                                                               Foreground="{StaticResource TeamsDarkText}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Message}"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource TeamsDarkTextSecondary}"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,4,0,0"/>
                                                                    <TextBlock Text="{Binding TimestampText}"
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource TeamsDarkTextTertiary}"
                                                                               Margin="0,6,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                        </StackPanel>
                    </Border>

                        <!-- Direct Contacts Section -->
                        <Border Grid.Column="2" Style="{StaticResource SectionStyle}" Margin="6,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Phone" Width="16" Height="16" Foreground="{StaticResource TeamsDarkTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="DIRECT CONTACTS" Style="{StaticResource SectionTitleStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource TeamsButtonStyle}"
                                            Command="{Binding AddContactCommand}"
                                            Padding="6,4">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Foreground="{StaticResource TeamsDarkText}" Margin="0,0,4,0"/>
                                            <TextBlock Text="Add" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                
                                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding DirectContacts}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                                <Border Background="{StaticResource TeamsDarkSurface}"
                                                        BorderBrush="{StaticResource TeamsDarkBorder}"
                                           BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="12"
                                                        Margin="0,0,6,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Row="0" Grid.Column="0"
                                                     Width="8"
                                                     Height="8" 
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>

                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontWeight="400"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TeamsDarkText}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2"
                                                       Orientation="Horizontal"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,10,0,0">
                                                <Button Style="{StaticResource TeamsDangerButtonStyle}"
                                                        Padding="8,6"
                                                        Margin="0,0,6,0"
                                                        MinWidth="0"
                                                        Command="{Binding DataContext.DeleteDirectContactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Delete">
                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                        <TextBlock Text="Delete" FontSize="10" FontWeight="600" Foreground="White" HorizontalAlignment="Center"/>
                                                        <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Foreground="White" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource TeamsPrimaryButtonStyle}"
                                                        Padding="8,6"
                                                        Margin="0,0,6,0"
                                                        MinWidth="0"
                                                        Command="{Binding DataContext.StartVoiceCallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Voice Call">
                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                        <TextBlock Text="Voice" FontSize="10" FontWeight="600" Foreground="White" HorizontalAlignment="Center"/>
                                                        <materialDesign:PackIcon Kind="Phone" Width="14" Height="14" Foreground="White" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource TeamsGreenButtonStyle}"
                                                        Padding="8,6"
                                                        MinWidth="0"
                                                        Command="{Binding DataContext.StartVideoCallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Video Call">
                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                        <TextBlock Text="Video" FontSize="10" FontWeight="600" Foreground="White" HorizontalAlignment="Center"/>
                                                        <materialDesign:PackIcon Kind="Video" Width="14" Height="14" Foreground="White" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                    </ScrollViewer>
                        </StackPanel>
                    </Border>
                    </Grid>

                <!-- Call Status/Info Area -->
                <Border Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Floating Call Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource TeamsDarkHeader}"
                BorderBrush="{StaticResource TeamsDarkBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,10"
                       Visibility="{Binding IsCallActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                <!-- Call Status Indicator -->
                <Ellipse Grid.Column="0"
                        Width="10"
                        Height="10"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Fill="{StaticResource TeamsGreen}"/>
                
                <!-- Call Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CallStatus}"
                               FontSize="14"
                               FontWeight="600"
                               Foreground="{StaticResource TeamsDarkText}"
                               Margin="0,0,0,2"/>
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource TeamsDarkTextTertiary}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} • {1}">
                                <Binding Path="CallDuration"/>
                                <Binding Path="CurrentCall.Type"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                            </StackPanel>
                
                <!-- Call Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TeamsDangerButtonStyle}"
                            Command="{Binding HangupCommand}"
                            Margin="0,0,8,0"
                            Padding="10,6"
                            ToolTip="End Call">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PhoneHangup" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="End" Foreground="White" FontSize="12" FontWeight="700"/>
                        </StackPanel>
                    </Button>

                    <Button Margin="0,0,8,0"
                            Padding="10,6"
                            ToolTip="Push To Talk"
                            PreviewMouseLeftButtonDown="PttButton_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="PttButton_PreviewMouseLeftButtonUp">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TeamsPrimaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentCall.Type}" Value="Direct">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPttTransmitting}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource TeamsGreen}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="PTT" Foreground="White" FontSize="12" FontWeight="700"/>
                    </Button>

                    <Button Command="{Binding ToggleLatchCommand}"
                            Margin="0,0,8,0"
                            Padding="10,6"
                            ToolTip="Latch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TeamsButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentCall.Type}" Value="Direct">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPttLatched}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource TeamsBlue}"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Latch" Foreground="White" FontSize="12" FontWeight="700"/>
                    </Button>

                    <Button Command="{Binding MuteCommand}"
                            Margin="0,0,8,0"
                            Padding="10,6"
                            ToolTip="Mute">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TeamsButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentCall.IsMuted}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource TeamsRed}"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="MicrophoneOff" Width="18" Height="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
