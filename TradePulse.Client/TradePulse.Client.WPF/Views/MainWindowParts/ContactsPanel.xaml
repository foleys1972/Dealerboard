<Border x:Class="TradePulse.Client.WPF.Views.MainWindowParts.ContactsPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        d:DesignWidth="440"
        BorderBrush="{StaticResource TeamsDarkBorder}"
        BorderThickness="0,0,1,0"
        Margin="0,0,24,0"
        Padding="0,0,24,0">
    <!--
        Left column: in-call video panel (with PTT/mute/hangup controls),
        contact search/filter, contacts list, current-user config summary,
        and groups list. DataContext is inherited from MainWindow
        (MainViewModel). PTT/mute event handlers live in this control's
        code-behind since they only touch DataContext/sender.DataContext,
        which resolve the same regardless of which control hosts them.
        The video WebView2 host is exposed via the VideoWebView property so
        MainWindow can still attach the media engine to it.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Video Panel (in-column) -->
        <Border Grid.Row="0"
               Background="Black"
               BorderBrush="{StaticResource TeamsDarkBorder}"
               BorderThickness="1"
               CornerRadius="8"
               Height="420"
               Margin="12,0,12,16"
               HorizontalAlignment="Stretch"
               Visibility="{Binding IsCallActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- In-call status banner (red -> green) -->
                <Border Grid.Row="0"
                        CornerRadius="6"
                        Padding="8"
                        Margin="12,12,12,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource TeamsRed}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentCall.State}" Value="Connected">
                                    <Setter Property="Background" Value="{StaticResource TeamsGreen}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <materialDesign:PackIcon Kind="PhoneInTalk" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding CallStatus}" Foreground="White" FontSize="12" FontWeight="700" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="12,6,12,8">
                    <TextBlock Text="{Binding CallStatus}"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="700"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CallDuration}"
                               Foreground="{StaticResource TeamsDarkTextSecondary}"
                               FontSize="11"
                               FontWeight="600"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <wv2:WebView2 x:Name="VideoWebViewElement"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"/>
                    </Grid>

                    <!-- In-call controls under video panel -->
                    <Border Grid.Row="1"
                            Background="#141414"
                            BorderBrush="{StaticResource TeamsDarkBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            Margin="12,8,12,12"
                            Visibility="{Binding IsCallActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource TeamsDangerButtonStyle}"
                                    Command="{Binding HangupCommand}"
                                    Padding="10,6"
                                    Margin="0,0,8,0"
                                    ToolTip="End Call">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PhoneHangup" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="End" Foreground="White" FontSize="12" FontWeight="700"/>
                                </StackPanel>
                            </Button>

                            <Button Padding="10,6"
                                    Margin="0,0,8,0"
                                    ToolTip="Push To Talk"
                                    PreviewMouseLeftButtonDown="PttButton_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="PttButton_PreviewMouseLeftButtonUp">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TeamsPrimaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPttTransmitting}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource TeamsGreen}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="PTT" Foreground="White" FontSize="12" FontWeight="700"/>
                            </Button>

                            <Button Command="{Binding ToggleLatchCommand}"
                                    Padding="10,6"
                                    Margin="0,0,8,0"
                                    ToolTip="Latch">
                                <Button.Content>
                                    <TextBlock Text="Latch" Foreground="White" FontSize="12" FontWeight="700"/>
                                </Button.Content>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TeamsButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPttLatched}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource TeamsBlue}"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Style="{StaticResource TeamsButtonStyle}"
                                    Command="{Binding AddVideoCommand}"
                                    Padding="10,6"
                                    Margin="0,0,8,0"
                                    ToolTip="Enable video"
                                    Visibility="{Binding CanAddVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Video" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Video" Foreground="White" FontSize="12" FontWeight="700"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding MuteCommand}"
                                    Padding="10,6"
                                    Margin="0,0,0,0"
                                    ToolTip="Mute">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TeamsButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentCall.IsMuted}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource TeamsRed}"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon Kind="MicrophoneOff" Width="16" Height="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Background="#2b2b2b"
                            BorderBrush="{StaticResource TeamsBlue}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="12"
                            VerticalAlignment="Bottom"
                            Visibility="{Binding HasIncomingCall, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="PhoneIncoming" Width="20" Height="20" Foreground="{StaticResource TeamsBlue}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Incoming call" FontSize="13" FontWeight="700" Foreground="White"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource TeamsDarkTextSecondary}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} ({1})">
                                            <Binding Path="CurrentCall.CallerName"/>
                                            <Binding Path="CurrentCall.CallerId"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource TeamsPrimaryButtonStyle}"
                                        Command="{Binding AnswerIncomingCallCommand}"
                                        Margin="0,0,8,0"
                                        Padding="10,6"
                                        ToolTip="Answer">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Phone" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                                        <TextBlock Text="Answer" Foreground="White" FontSize="13" FontWeight="600"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TeamsDangerButtonStyle}"
                                        Command="{Binding RejectIncomingCallCommand}"
                                        Padding="10,6"
                                        ToolTip="Reject">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PhoneHangup" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                                        <TextBlock Text="Reject" Foreground="White" FontSize="13" FontWeight="600"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Search Header -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Contacts"
                       FontSize="20"
                       FontWeight="600"
                       Foreground="{StaticResource TeamsDarkText}"
                       Margin="0,0,0,12"/>
            <TextBox materialDesign:HintAssist.Hint="Search contacts..."
                     materialDesign:HintAssist.IsFloating="True"
                     FontSize="14"
                     Height="40"
                     Padding="12,0"
                     Background="{StaticResource TeamsDarkSurface}"
                     Foreground="{StaticResource TeamsDarkText}"
                     BorderBrush="{StaticResource TeamsDarkBorderHover}"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding CompanyOptions}"
                          SelectedItem="{Binding SelectedCompany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Height="34"
                          Background="{StaticResource TeamsDarkSurface}"
                          Foreground="{StaticResource TeamsDarkText}"
                          BorderBrush="{StaticResource TeamsDarkBorderHover}"
                          ToolTip="Company"/>

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding LocationOptions}"
                          SelectedItem="{Binding SelectedLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Height="34"
                          Background="{StaticResource TeamsDarkSurface}"
                          Foreground="{StaticResource TeamsDarkText}"
                          BorderBrush="{StaticResource TeamsDarkBorderHover}"
                          ToolTip="Location"/>

                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding TenantScopeOptions}"
                          SelectedItem="{Binding SelectedTenantScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Height="34"
                          Background="{StaticResource TeamsDarkSurface}"
                          Foreground="{StaticResource TeamsDarkText}"
                          BorderBrush="{StaticResource TeamsDarkBorderHover}"
                          ToolTip="Scope"/>
            </Grid>
        </StackPanel>

        <!-- Contacts List -->
        <Border Grid.Row="2"
                Background="{StaticResource TeamsDarkSurface}"
                BorderBrush="{StaticResource TeamsDarkBorder}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,12">
            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Contacts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource TeamsDarkBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TeamsDarkText}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource TeamsDarkTextTertiary}"
                                                   Margin="0,4,0,0">
                                            <Run Text="{Binding Username, Mode=OneWay}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding SipUri, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource TeamsPrimaryButtonStyle}"
                                                Padding="10,6"
                                                Margin="0,0,8,0"
                                                Command="{Binding DataContext.StartCallForContactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Voice Call">
                                            <materialDesign:PackIcon Kind="Phone" Width="16" Height="16" Foreground="White"/>
                                        </Button>

                                        <Button Style="{StaticResource TeamsGreenButtonStyle}"
                                                Padding="10,6"
                                                Command="{Binding DataContext.StartVideoCallForContactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Video Call">
                                            <materialDesign:PackIcon Kind="Video" Width="16" Height="16" Foreground="White"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- User Configuration Panel -->
        <Border Grid.Row="3"
               Visibility="{Binding CurrentUser, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Background="{StaticResource TeamsDarkSurface}"
                   BorderBrush="{StaticResource TeamsDarkBorder}"
               BorderThickness="1"
                   CornerRadius="4"
                   Padding="12"
                   Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="User Configuration"
                              FontWeight="600"
                              FontSize="14"
                              Foreground="{StaticResource TeamsDarkText}"
                              Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Intercom:" FontWeight="400" Margin="0,0,10,4" Foreground="{StaticResource TeamsDarkTextSecondary}" FontSize="12"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                                  FontWeight="600"
                                  Margin="0,0,0,4"
                                  FontSize="12"
                                  Text="{Binding CurrentUser.IntercomEnabled}"
                                  Foreground="{Binding CurrentUser.IntercomEnabled, Converter={StaticResource BooleanToColorConverter}}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Dealerboard:" FontWeight="400" Margin="0,0,10,4" Foreground="{StaticResource TeamsDarkTextSecondary}" FontSize="12"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                                  FontWeight="600"
                                  Margin="0,0,0,4"
                                  FontSize="12"
                                  Text="{Binding CurrentUser.DealerboardEnabled}"
                                  Foreground="{Binding CurrentUser.DealerboardEnabled, Converter={StaticResource BooleanToColorConverter}}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Role:" FontWeight="400" Margin="0,0,10,0" Foreground="{StaticResource TeamsDarkTextSecondary}" FontSize="12"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                              Text="{Binding CurrentUser.Role}"
                                  Foreground="{StaticResource TeamsDarkTextTertiary}"
                                  FontWeight="400"
                                  FontSize="12"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Groups Section -->
        <Border Grid.Row="4"
               Visibility="{Binding CurrentUser, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Background="{StaticResource TeamsDarkSurface}"
                   BorderBrush="{StaticResource TeamsDarkBorder}"
               BorderThickness="1"
                   CornerRadius="4"
                   Padding="12"
                   Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Groups"
                              FontWeight="600"
                              FontSize="14"
                              Foreground="{StaticResource TeamsDarkText}"
                              Margin="0,0,0,8"/>
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding Groups}"
                            SelectedItem="{Binding SelectedGroup}"
                            BorderThickness="0"
                            Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                    <Border Background="{StaticResource TeamsDarkSurface}"
                                           Padding="10,8"
                                           Margin="0,0,0,6"
                                           CornerRadius="4"
                                           BorderBrush="{StaticResource TeamsDarkBorder}"
                                       BorderThickness="1"
                                       Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                      FontWeight="400"
                                                      FontSize="13"
                                                      Foreground="{StaticResource TeamsDarkText}"/>
                                        <TextBlock Text="{Binding Description}"
                                                      FontSize="11"
                                                      Foreground="{StaticResource TeamsDarkTextTertiary}"
                                                  Margin="0,4,0,0"
                                                  TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Border>
