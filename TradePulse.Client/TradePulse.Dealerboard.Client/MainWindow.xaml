<Window x:Class="TradePulse.Dealerboard.Client.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:TradePulse.Dealerboard.Client"
        xmlns:converters="clr-namespace:TradePulse.Dealerboard.Client.Converters"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="TradeCom Dealerboard" 
        Height="900" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1b1b1b"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Dark Theme Colors -->
        <SolidColorBrush x:Key="DarkBackground" Color="#1b1b1b"/>
        <SolidColorBrush x:Key="DarkSurface" Color="#2d2c2c"/>
        <SolidColorBrush x:Key="DarkText" Color="#ffffff"/>
        <SolidColorBrush x:Key="DarkTextSecondary" Color="#B3FFFFFF"/>
        <SolidColorBrush x:Key="DarkBorder" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#0078d4"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:ScaleToFitDownOnlyConverter x:Key="ScaleToFitDownOnlyConverter" />
    </Window.Resources>
    
    <!-- Responsive layout: do NOT scale the whole UI with a Viewbox.
         Instead, guarantee the dealerboard grid keeps enough vertical space and allow lower panels to scroll. -->
    <Grid SnapsToDevicePixels="True"
          TextOptions.TextFormattingMode="Display">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource DarkSurface}" 
                BorderBrush="{StaticResource DarkBorder}" 
                BorderThickness="0,0,0,1"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="TradeCom Dealerboard" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Foreground="{StaticResource DarkText}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding CurrentUsername, StringFormat='User: {0}'}" 
                               FontSize="14"
                               Foreground="{StaticResource DarkTextSecondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Border CornerRadius="4"
                             Padding="8,4"
                             VerticalAlignment="Center"
                             Background="{Binding IsConnected, Converter={StaticResource BooleanToColorConverter}}">
                        <TextBlock Text="{Binding ConnectionStatus}" 
                                   FontSize="12"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- Manual retry (Intercom parity) -->
                    <Button Content="Retry"
                            Command="{Binding RetryConnectionCommand}"
                            Foreground="{StaticResource DarkText}"
                            Margin="8,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Content="DND"
                                  IsChecked="{Binding IsDndEnabled}"
                                  Command="{Binding ToggleDndCommand}"
                                  Style="{StaticResource MaterialDesignFlatButton}"
                                  Foreground="{StaticResource DarkText}"
                                  Margin="0,0,8,0"/>

                    <ToggleButton Content="CF Intercom"
                                  IsChecked="{Binding IsIntercomCallForwardEnabled}"
                                  Command="{Binding ToggleIntercomCallForwardCommand}"
                                  Style="{StaticResource MaterialDesignFlatButton}"
                                  Foreground="{StaticResource DarkText}"
                                  Margin="0,0,8,0"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <ToggleButton Content="CF Line"
                                      IsChecked="{Binding IsLineCallForwardEnabled}"
                                      Command="{Binding ToggleLineCallForwardCommand}"
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      Foreground="{StaticResource DarkText}"
                                      Margin="0,0,8,0"/>
                        <ComboBox Width="160"
                                  ItemsSource="{Binding CallForwardLineOptions}"
                                  SelectedItem="{Binding SelectedCallForwardLine}"
                                  Background="#1f1f1f"
                                  Foreground="White"
                                  BorderBrush="#333333" />
                    </StackPanel>

                    <Button Content="Settings" 
                            Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource DarkText}"
                            Margin="0,0,8,0"/>

                    <Button Content="Exit"
                            Command="{Binding ExitCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource DarkText}"
                            Margin="0,0,8,0"/>

                    <Button Content="Logout" 
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource PrimaryBlue}"
                            Foreground="White"
                            Margin="0,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content
             Goal: on smaller screens, everything should stay the same but smaller (uniform downscale).
             We render the layout on a fixed "design surface" and scale DOWN to fit the available area. -->
        <Grid x:Name="MainContentHost"
              Grid.Row="1"
              Margin="12"
              Background="{StaticResource DarkBackground}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <Grid x:Name="MainContentDesign"
                  Width="1920"
                  Height="900"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Grid.LayoutTransform>
                    <ScaleTransform>
                        <ScaleTransform.ScaleX>
                            <MultiBinding Converter="{StaticResource ScaleToFitDownOnlyConverter}">
                                <Binding ElementName="MainContentHost" Path="ActualWidth"/>
                                <Binding ElementName="MainContentHost" Path="ActualHeight"/>
                                <Binding Source="1920"/>
                                <Binding Source="900"/>
                            </MultiBinding>
                        </ScaleTransform.ScaleX>
                        <ScaleTransform.ScaleY>
                            <MultiBinding Converter="{StaticResource ScaleToFitDownOnlyConverter}">
                                <Binding ElementName="MainContentHost" Path="ActualWidth"/>
                                <Binding ElementName="MainContentHost" Path="ActualHeight"/>
                                <Binding Source="1920"/>
                                <Binding Source="900"/>
                            </MultiBinding>
                        </ScaleTransform.ScaleY>
                    </ScaleTransform>
                </Grid.LayoutTransform>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <!-- Match reference layout proportions: keep enough space for lower panels (directory/video/dialpad/etc). -->
                    <!-- Reduce dealerboard height ~20% to prevent lower panels overlapping on shorter screens -->
                    <!-- Reduce dealerboard height a further ~15% to remove final overlap -->
                    <RowDefinition Height="11*" MinHeight="280" />
                    <RowDefinition Height="5*" MinHeight="140" />
                </Grid.RowDefinitions>

            <!-- Button grid + page header -->
            <Border x:Name="LineButtonModule"
                    Grid.Column="0" Grid.Row="0"
                    Background="{StaticResource DarkSurface}"
                    BorderBrush="{StaticResource DarkBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14"
                    Margin="0,0,12,0"
                    VerticalAlignment="Stretch"
                    MinHeight="220">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header / Pagination -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="#92400e"
                                BorderBrush="#f59e0b"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,8"
                                Visibility="{Binding HasRingingLines, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Command="{Binding AnswerNextRingingLineCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalContentAlignment="Stretch"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PhoneIncoming" Width="18" Height="18" Foreground="White" Margin="0,0,8,0" />
                                    <TextBlock Foreground="White" FontWeight="SemiBold">
                                        <Run Text="{Binding GlobalRingingCount, Mode=OneWay}" />
                                        <Run Text=" line(s) ringing — tap to go to page and answer" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Dealerboard"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DarkText}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="◀" Command="{Binding PrevPageCommand}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CurrentPage, StringFormat=Page {0}}" Foreground="{StaticResource DarkTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="▶" Command="{Binding NextPageCommand}" />
                            <Button Content="⟳" Command="{Binding RefreshDealerboardCommand}" Margin="8,0,0,0" ToolTip="Refresh from Admin Portal" />
                        </StackPanel>
                    </Grid>
                    </Grid>

                    <!-- 7x4 Button Grid (visually matches web dealerboard) -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Buttons}" VerticalAlignment="Stretch" ClipToBounds="True" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="4" Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Prevent oversized dealerboard buttons: allow them to scale down, only keep a modest minimum. -->
                                <!-- ~20% smaller min height to give the lower layout more room -->
                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Margin="2" MinHeight="44">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1f1f1f" />
                                            <Setter Property="BorderBrush" Value="#333333" />
                                            <Style.Triggers>
                                                <!-- Monitoring: subtle border only (not a line state) -->
                                                <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#f59e0b" />
                                                </DataTrigger>

                                                <!-- No SBC/SIP connectivity -->
                                                <DataTrigger Binding="{Binding IsDisconnected}" Value="True">
                                                    <Setter Property="Background" Value="#7f1d1d" />
                                                    <Setter Property="BorderBrush" Value="#ef4444" />
                                                </DataTrigger>

                                                <!-- Busy: line in use by someone else -->
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Background" Value="#7f1d1d" />
                                                    <Setter Property="BorderBrush" Value="#ef4444" />
                                                </DataTrigger>

                                                <!-- Private: this user is on the line -->
                                                <DataTrigger Binding="{Binding IsPrivate}" Value="True">
                                                    <Setter Property="Background" Value="#166534" />
                                                    <Setter Property="BorderBrush" Value="#22c55e" />
                                                </DataTrigger>

                                                <!-- Ringing: incoming call (highest priority) — red flash like web/IPC -->
                                                <DataTrigger Binding="{Binding IsRinging}" Value="True">
                                                    <Setter Property="Background" Value="#dc2626" />
                                                    <Setter Property="BorderBrush" Value="#ef4444" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                                From="#ef4444" To="#450a0a" Duration="0:0:0.4" AutoReverse="True" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Header row (label + monitor toggle). Toggle is above click surface. -->
                                        <Grid Grid.Row="0" Panel.ZIndex="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding PageLabel}" Foreground="#B3FFFFFF" FontSize="9" FontFamily="Consolas" />
                                            <ToggleButton Grid.Column="1"
                                                          IsChecked="{Binding IsMonitoring, Mode=OneWay}"
                                                          Width="34"
                                                          Height="16"
                                                          Margin="4,0,0,0"
                                                          Padding="2,0"
                                                          FontSize="8"
                                                          FontWeight="Bold"
                                                          Content="MON"
                                                          ToolTip="Monitor live audio on speaker (listen only)"
                                                          Command="{Binding DataContext.ToggleMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Background" Value="#333333" />
                                                        <Setter Property="Foreground" Value="#888888" />
                                                        <Setter Property="BorderBrush" Value="#555555" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter Property="Background" Value="#f59e0b" />
                                                                <Setter Property="Foreground" Value="#1f1f1f" />
                                                                <Setter Property="BorderBrush" Value="#fbbf24" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                        </Grid>

                                        <!-- Click surface for 'speak' (separate button so monitor toggle doesn't trigger it) -->
                                        <Button Grid.RowSpan="2"
                                                Panel.ZIndex="1"
                                                Style="{x:Null}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.LinePressedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayLabel}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding SubLabel}" Foreground="#B3FFFFFF" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Monitor Column -->
            <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                    Background="{StaticResource DarkSurface}"
                    BorderBrush="{StaticResource DarkBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="280" />
                        <RowDefinition Height="Auto" MaxHeight="100" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Speaker Monitor · Max 10" Foreground="#f59e0b" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8" />

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MonitoredLines}" Margin="0,0,0,8" VerticalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="10" Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Margin="0,0,0,2" Padding="4,2" VerticalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="#555555" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                                    <Setter Property="Background" Value="#1e3a5f" />
                                                    <Setter Property="BorderBrush" Value="#f59e0b" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding PositionLabel}" Foreground="#f59e0b" FontSize="10" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="MONITOR" Foreground="#B3FFFFFF" FontSize="8" FontWeight="Bold" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="✕"
                                                Width="22" Height="22"
                                                FontSize="10"
                                                Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                Command="{Binding DataContext.StopMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Stop monitoring"
                                                Background="#333333" Foreground="White" BorderBrush="#555555" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Notifications" Foreground="{StaticResource DarkTextSecondary}" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Border Grid.Row="1" Background="#1f1f1f" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Notifications}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <materialDesign:PackIcon Grid.Column="0" Kind="{Binding IconKind}" Width="16" Height="16" Foreground="White" Margin="0,2,8,0" VerticalAlignment="Top"/>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource DarkTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding TimestampText}" Foreground="{StaticResource DarkTextSecondary}" FontSize="10" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Bottom Controls -->
            <Border Grid.Column="0" Grid.Row="1"
                    Background="{StaticResource DarkSurface}"
                    BorderBrush="{StaticResource DarkBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,12,12,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Intercom Groups ~20% narrower -->
                        <ColumnDefinition Width="192" />
                        <ColumnDefinition Width="300" />
                        <!-- Dial Pad ~10% narrower -->
                        <ColumnDefinition Width="324" />
                        <!-- Give freed space primarily to Direct Contacts -->
                        <ColumnDefinition Width="6.8*" />
                        <ColumnDefinition Width="4.2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                            Background="#111111"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,8,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Intercom Groups" Foreground="{StaticResource DarkTextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding IntercomGroupSlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="10" Columns="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{x:Null}"
                                                Content="{Binding DisplayLabel}"
                                                Height="28"
                                                Foreground="White"
                                                Background="#1f1f1f"
                                                BorderBrush="#333333"
                                                Command="{Binding DataContext.StartIntercomGroupFromSlotCommand, ElementName=RootWindow}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                            Background="#111111"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            Margin="0,0,8,0"
                            VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" CornerRadius="6" Padding="10,6" Margin="0,0,0,8" Background="{Binding CallBannerBrush}"
                                    Visibility="{Binding IsAnyCallActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding CallStatus}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Text="{Binding CallDuration}" Foreground="#E6FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" CornerRadius="6" Background="#000000" BorderBrush="#333333" BorderThickness="1">
                                <Grid>
                                    <wv2:WebView2 x:Name="VideoWebView" />
                                    <Border Background="#66000000"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="10"
                                            Panel.ZIndex="10">
                                        <TextBlock Text="Intercom" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Background="#141414"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsCallActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <WrapPanel Orientation="Horizontal">
                                    <Button Style="{x:Null}"
                                            Command="{Binding HangupCommand}"
                                            Padding="10,6"
                                            Margin="0,0,8,0"
                                            Foreground="White"
                                            Background="#ef4444"
                                            BorderBrush="#ef4444">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="PhoneHangup" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                                            <TextBlock Text="End" Foreground="White" FontSize="12" FontWeight="700"/>
                                        </StackPanel>
                                    </Button>

                                    <Button
                                            Padding="10,6"
                                            Margin="0,0,8,0"
                                            ToolTip="Push To Talk"
                                            PreviewMouseLeftButtonDown="PttButton_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="PttButton_PreviewMouseLeftButtonUp">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#3b82f6" />
                                                <Setter Property="BorderBrush" Value="#3b82f6" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPttTransmitting}" Value="True">
                                                        <Setter Property="Background" Value="#16a34a" />
                                                        <Setter Property="BorderBrush" Value="#16a34a" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="PTT" Foreground="White" FontSize="12" FontWeight="700"/>
                                    </Button>

                                    <Button Command="{Binding ToggleLatchCommand}"
                                            Padding="10,6"
                                            Margin="0,0,8,0"
                                            ToolTip="Latch">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#2b2b2b" />
                                                <Setter Property="BorderBrush" Value="#444444" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPttLatched}" Value="True">
                                                        <Setter Property="Background" Value="#2563eb" />
                                                        <Setter Property="BorderBrush" Value="#2563eb" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="Latch" Foreground="White" FontSize="12" FontWeight="700"/>
                                    </Button>

                                    <Button Command="{Binding MuteCommand}"
                                            Padding="10,6"
                                            Margin="0,0,0,0"
                                            ToolTip="Mute">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#2b2b2b" />
                                                <Setter Property="BorderBrush" Value="#444444" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Background" Value="#ef4444" />
                                                        <Setter Property="BorderBrush" Value="#ef4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <materialDesign:PackIcon Kind="MicrophoneOff" Width="16" Height="16" Foreground="White" />
                                    </Button>
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                            Background="#1f1f1f"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,8,0"
                            VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <!-- Dial pad action buttons ~10% narrower -->
                                <ColumnDefinition Width="99" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <UniformGrid Grid.Column="0" Grid.Row="0" Rows="4" Columns="3">
                                <Button Style="{x:Null}" Content="1" Margin="6" Padding="18" FontSize="22" Foreground="White" Background="#2b2b2b" BorderBrush="#555555" Command="{Binding DialDigitCommand}" CommandParameter="1" />
                                <Button Style="{x:Null}" Content="2" Margin="6" Padding="18" FontSize="22" Foreground="White" Background="#2b2b2b" BorderBrush="#555555" Command="{Binding DialDigitCommand}" CommandParameter="2" />
                                <Button Style="{x:Null}" Content="3" Margin="6" Padding="18" FontSize="22" Foreground="White" Background="#2b2b2b" BorderBrush="#555555" Command="{Binding DialDigitCommand}" CommandParameter="3" />
                                <Button Style="{x:Null}" Content="4" Margin="6" Padding="18" FontSize="22" Foreground="White" Background="#2b2b2b" BorderBrush="#555555" Command="{Binding DialDigitCommand}" CommandParameter="4" />
                                <Button Style="{x:Null}" Content="5" Margin="6" Padding="18" FontSize="22" Foreground="White" Background="#2b2b2b" BorderBrush="#555555" Command="{Binding DialDigitCommand}" CommandParameter="5" />
                                <Button Style="{x:Null}" Content="6" Margin="6" Padding="18" FontSize="22" Foreground="White" Background="#2b2b2b" BorderBrush="#555555" Command="{Binding DialDigitCommand}" CommandParameter="6" />
                                <Button Style="{x:Null}" Content="7" Margin="6" Padding="18" FontSize="22" Foreground="White" Background="#2b2b2b" BorderBrush="#555555" Command="{Binding DialDigitCommand}" CommandParameter="7" />
                                <Button Style="{x:Null}" Content="8" Margin="6" Padding="18" FontSize="22" Foreground="White" Background="#2b2b2b" BorderBrush="#555555" Command="{Binding DialDigitCommand}" CommandParameter="8" />
                                <Button Style="{x:Null}" Content="9" Margin="6" Padding="18" FontSize="22" Foreground="White" Background="#2b2b2b" BorderBrush="#555555" Command="{Binding DialDigitCommand}" CommandParameter="9" />
                                <Button Style="{x:Null}" Content="*" Margin="6" Padding="18" FontSize="22" Foreground="White" Background="#2b2b2b" BorderBrush="#555555" Command="{Binding DialDigitCommand}" CommandParameter="*" />
                                <Button Style="{x:Null}" Content="0" Margin="6" Padding="18" FontSize="22" Foreground="White" Background="#2b2b2b" BorderBrush="#555555" Command="{Binding DialDigitCommand}" CommandParameter="0" />
                                <Button Style="{x:Null}" Content="#" Margin="6" Padding="18" FontSize="22" Foreground="White" Background="#2b2b2b" BorderBrush="#555555" Command="{Binding DialDigitCommand}" CommandParameter="#" />
                            </UniformGrid>

                            <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding DialedDigits}" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="6,10,6,0" HorizontalAlignment="Center" />

                            <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="8,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0"
                                        Style="{x:Null}"
                                        Content="Call"
                                        Padding="16,12"
                                        Foreground="White"
                                        Background="#3b82f6"
                                        BorderBrush="#3b82f6"
                                        Command="{Binding DialCallCommand}" />

                                <Button Grid.Row="2"
                                        Content="End Call"
                                        Padding="24,24"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        MinHeight="72"
                                        Background="#ef4444"
                                        BorderBrush="#ef4444"
                                        BorderThickness="1"
                                        Foreground="White"
                                        OverridesDefaultStyle="True"
                                        Command="{Binding EndLineCallCommand}"
                                        IsEnabled="{Binding CanEndLineCall}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#ef4444" />
                                            <Setter Property="BorderBrush" Value="#ef4444" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              RecognizesAccessKey="True" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                    <Setter Property="Background" Value="#ef4444" />
                                                    <Setter Property="BorderBrush" Value="#ef4444" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Row="4"
                                        Content="Xfer"
                                        Padding="16,12"
                                        Foreground="White"
                                        BorderThickness="1"
                                        OverridesDefaultStyle="True"
                                        Command="{Binding TransferLineCommand}"
                                        IsEnabled="{Binding HasActiveLineCall}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2b2b2b" />
                                            <Setter Property="BorderBrush" Value="#444444" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TransferMode}" Value="True">
                                                    <Setter Property="Background" Value="#b45309" />
                                                    <Setter Property="BorderBrush" Value="#f59e0b" />
                                                </DataTrigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Row="6"
                                        Content="Conf"
                                        Padding="16,12"
                                        Foreground="White"
                                        BorderThickness="1"
                                        OverridesDefaultStyle="True"
                                        Command="{Binding ConferenceLineCommand}"
                                        IsEnabled="{Binding HasActiveLineCall}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2b2b2b" />
                                            <Setter Property="BorderBrush" Value="#444444" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConferenceMode}" Value="True">
                                                    <Setter Property="Background" Value="#b45309" />
                                                    <Setter Property="BorderBrush" Value="#f59e0b" />
                                                </DataTrigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Row="8"
                                        Content="Signal"
                                        Padding="16,12"
                                        Foreground="White"
                                        Background="#2b2b2b"
                                        BorderBrush="#444444"
                                        BorderThickness="1"
                                        OverridesDefaultStyle="True"
                                        Command="{Binding SignalLineCommand}"
                                        IsEnabled="{Binding HasActiveLineCall}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Grid.Row="0" Grid.RowSpan="2"
                            Background="#111111"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Direct Contacts" Foreground="{StaticResource DarkTextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Command="{Binding AddDirectContactCommand, ElementName=RootWindow}"
                                        ToolTip="Add direct contact by username"
                                        Padding="6,2"
                                        Background="#2b2b2b"
                                        Foreground="White"
                                        BorderBrush="#444444">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Foreground="White" Margin="0,0,4,0" />
                                        <TextBlock Text="Add" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding DirectContactSlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="10" Columns="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Direct Contacts: make each row ~10% taller, but keep the red/blue/green action buttons compact.
                                             Tighten gaps and slightly shrink icon/text so everything fits cleanly. -->
                                        <Border Background="#1f1f1f" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="1" Margin="0,0,0,1" Height="32"
                                                PreviewMouseLeftButtonDown="DirectContactRow_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="DirectContactRow_PreviewMouseLeftButtonUp"
                                                MouseLeave="DirectContactRow_MouseLeave">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                                             Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                                                    <TextBlock Text="{Binding DisplayLabel}" Foreground="White" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.ToolTip>
                                                            <TextBlock>
                                                                <Run Text="{Binding DisplayLabel}" />
                                                                <Run Text="  " />
                                                                <Run Text="{Binding Contact.ContactUserId}" />
                                                            </TextBlock>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding IsAssigned, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <!-- Delete is now handled via long-press on the row -->
                                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" Margin="0,0,6,0" ToolTip="Voice Call"
                                                            Command="{Binding DataContext.StartDirectContactVoiceCommand, ElementName=RootWindow}"
                                                            CommandParameter="{Binding Contact}">
                                                        <Button.Background>#2563eb</Button.Background>
                                                        <Button.BorderBrush>#2563eb</Button.BorderBrush>
                                                        <Button.Foreground>White</Button.Foreground>
                                                        <Button.BorderThickness>1</Button.BorderThickness>
                                                        <Button.OverridesDefaultStyle>True</Button.OverridesDefaultStyle>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <materialDesign:PackIcon Kind="Phone" Width="16" Height="16" Foreground="White" />
                                                    </Button>

                                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" ToolTip="Video Call"
                                                            Command="{Binding DataContext.StartDirectContactVideoCommand, ElementName=RootWindow}"
                                                            CommandParameter="{Binding Contact}">
                                                        <Button.Background>#16a34a</Button.Background>
                                                        <Button.BorderBrush>#16a34a</Button.BorderBrush>
                                                        <Button.Foreground>White</Button.Foreground>
                                                        <Button.BorderThickness>1</Button.BorderThickness>
                                                        <Button.OverridesDefaultStyle>True</Button.OverridesDefaultStyle>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <materialDesign:PackIcon Kind="Video" Width="16" Height="16" Foreground="White" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Grid.Row="0" Grid.RowSpan="2"
                            Background="{StaticResource DarkSurface}"
                            BorderBrush="{StaticResource DarkBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Contacts" Foreground="{StaticResource DarkTextSecondary}" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Border Grid.Row="1" Background="#1f1f1f" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="6">
                                <StackPanel>
                                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,10" Background="#111111" Foreground="White" BorderBrush="#333333" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding CompanyOptions}"
                                                  SelectedItem="{Binding SelectedCompany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Height="28"
                                                  Background="#111111"
                                                  Foreground="White"
                                                  BorderBrush="#333333"/>

                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding LocationOptions}"
                                                  SelectedItem="{Binding SelectedLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Height="28"
                                                  Background="#111111"
                                                  Foreground="White"
                                                  BorderBrush="#333333"/>

                                        <ComboBox Grid.Column="4"
                                                  ItemsSource="{Binding TenantScopeOptions}"
                                                  SelectedItem="{Binding SelectedTenantScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Height="28"
                                                  Background="#111111"
                                                  Foreground="White"
                                                  BorderBrush="#333333"/>
                                    </Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Contacts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,6"
                                                            PreviewMouseLeftButtonDown="ContactRow_PreviewMouseLeftButtonDown"
                                                            PreviewMouseLeftButtonUp="ContactRow_PreviewMouseLeftButtonUp"
                                                            MouseLeave="ContactRow_MouseLeave">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                     Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />

                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" Foreground="White" TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.ToolTip>
                                                                        <TextBlock Text="{Binding Name}" />
                                                                    </TextBlock.ToolTip>
                                                                </TextBlock>
                                                                <TextBlock Foreground="{StaticResource DarkTextSecondary}" FontSize="10" TextTrimming="None" TextWrapping="NoWrap">
                                                                    <TextBlock.ToolTip>
                                                                        <TextBlock Text="{Binding Username}" />
                                                                    </TextBlock.ToolTip>
                                                                    <Run Text="{Binding Username}" />
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,-1,0,-1">
                                                                <Button Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" Margin="0,0,6,0" ToolTip="Add to direct contacts"
                                                                        Command="{Binding DataContext.AddDirectContactForUserCommand, ElementName=RootWindow}"
                                                                        CommandParameter="{Binding}">
                                                                    <Button.Background>#374151</Button.Background>
                                                                    <Button.BorderBrush>#374151</Button.BorderBrush>
                                                                    <Button.Foreground>White</Button.Foreground>
                                                                    <Button.OverridesDefaultStyle>True</Button.OverridesDefaultStyle>
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                    <materialDesign:PackIcon Kind="AccountPlus" Width="16" Height="16" Foreground="White" />
                                                                </Button>
                                                                <Button Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" Margin="0,0,6,0" ToolTip="Voice Call"
                                                                        Command="{Binding DataContext.StartCallForContactCommand, ElementName=RootWindow}"
                                                                        CommandParameter="{Binding}">
                                                                    <Button.Background>#3b82f6</Button.Background>
                                                                    <Button.BorderBrush>#3b82f6</Button.BorderBrush>
                                                                    <Button.Foreground>White</Button.Foreground>
                                                                    <Button.OverridesDefaultStyle>True</Button.OverridesDefaultStyle>
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                    <materialDesign:PackIcon Kind="Phone" Width="16" Height="16" Foreground="White" />
                                                                </Button>
                                                                <Button Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" ToolTip="Video Call"
                                                                        Command="{Binding DataContext.StartVideoCallForContactCommand, ElementName=RootWindow}"
                                                                        CommandParameter="{Binding}">
                                                                    <Button.Background>#22c55e</Button.Background>
                                                                    <Button.BorderBrush>#22c55e</Button.BorderBrush>
                                                                    <Button.Foreground>White</Button.Foreground>
                                                                    <Button.OverridesDefaultStyle>True</Button.OverridesDefaultStyle>
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                    <materialDesign:PackIcon Kind="Video" Width="16" Height="16" Foreground="White" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" 
                Background="{StaticResource DarkSurface}" 
                BorderBrush="{StaticResource DarkBorder}" 
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock Text="TradeCom Dealerboard" 
                       FontSize="12"
                       Foreground="{StaticResource DarkTextSecondary}"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
