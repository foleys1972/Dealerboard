# Copy to server.env or .env and set values for your environment.
# Production: NODE_ENV=production and a strong JWT_SECRET (32+ random chars) are required.

NODE_ENV=development
PORT=5000

# Required in production
JWT_SECRET=
JWT_EXPIRES_IN=24h
# Optional second signing secret for distributed uploaders
# JWT_ACCESS_TOKEN_SECRET=

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_intercom
POSTGRES_USER=intercom_app
POSTGRES_PASSWORD=
POSTGRES_SSL=false

# Redis (optional)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Client / CORS
CLIENT_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

# HTTPS (optional)
# HTTPS_ENABLED=true
# SSL_CERT_FILE=
# SSL_KEY_FILE=

# Multi-tenant
DEFAULT_TENANT_SLUG=default
# ROOT_DOMAIN=example.com

# Federation (lock /api/federation with FEDERATION_SECRET header)
# FEDERATION_ENABLED=true
FEDERATION_SECRET=

# Local Windows agent (/api/agent)
# ENABLE_LOCAL_AGENT=true
AGENT_TOKEN=

# Subscriber HA
# SUBSCRIBER_HA_ENABLED=true

# Dev only — never enable in production
# ALLOW_BOOTSTRAP_USERS=false
